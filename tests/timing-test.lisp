;;;; TIMING-HANDLER (timing.lisp).

(in-package #:middleware-protocol/tests)

(defun %clock (&rest readings)
  "A clock that returns READINGS one after the other and notes :CLOCK."
  (lambda ()
    (note :clock)
    (if readings (pop readings) (error "clock read too often"))))

(defun %reporter (log)
  "A report function that pushes (request response seconds) onto the cons LOG's car."
  (lambda (request response seconds)
    (note :report)
    (push (list request response seconds) (car log))))

(deftest timing-reports-an-immediate-response
  (let* ((log (list '()))
         (response (list 200 '() '("ok")))
         (handler (make-handler '(timing-handler function-handler)
                                :function (constantly response)
                                :timing-report (%reporter log)
                                :timing-clock (%clock 10 13))))
    (multiple-value-bind (trace result) (traced (handle handler :req))
      (ok (eq response result) "the response is returned unchanged")
      (ok (equal '(:clock :clock :report) trace))
      (ok (= 1 (length (car log))))
      (destructuring-bind (request reported seconds) (first (car log))
        (ok (eq :req request))
        (ok (eq response reported))
        (ok (= 3 seconds))))))

(deftest timing-reads-the-clock-around-the-inner-layers
  (let* ((log (list '()))
         (handler (make-handler '(timing-handler m-inner function-handler)
                                :function (primary :done)
                                :timing-report (%reporter log)
                                :timing-clock (%clock 0 1))))
    (let ((trace (traced (handle handler :r))))
      (ok (eq :clock (first trace)) "START is read before any inner layer")
      (ok (equal '(:clock :report) (last trace 2)) "END is read after every inner layer")
      (ok (equal '((:enter m-inner)) (subseq trace 1 2))))))

(deftest timing-without-report-is-transparent
  (let* ((response (list :r))
         (handler (make-handler '(timing-handler function-handler)
                                :function (constantly response)
                                :timing-clock (%clock))))
    (multiple-value-bind (trace result) (traced (handle handler :req))
      (ok (eq response result))
      (ok (null trace) "the clock is not read"))))

(deftest timing-a-streaming-response-reports-at-the-head
  (let* ((log (list '()))
         (handler (make-handler '(timing-handler function-handler)
                                :function (constantly (streaming-app-response (list 200 '()) "a" "b"))
                                :timing-report (%reporter log)
                                :timing-clock (%clock 100 105)))
         (response (handle handler :req)))
    (ok (functionp response))
    (ok (null (car log)) "no report before the server runs the response")
    (multiple-value-bind (head chunks) (run-streaming response)
      (ok (equal '(200 ()) head))
      (ok (equal '("a" "b") chunks)))
    (ok (= 1 (length (car log))))
    (destructuring-bind (request reported seconds) (first (car log))
      (ok (eq :req request))
      (ok (equal '(200 ()) reported))
      (ok (= 5 seconds)))))

(deftest timing-a-promise-reports-on-resolution
  (multiple-value-bind (promise resolve) (pending-promise)
    (let* ((log (list '()))
           (handler (make-handler '(timing-handler function-handler)
                                  :function (constantly promise)
                                  :timing-report (%reporter log)
                                  :timing-clock (%clock 1 9)))
           (response (handle handler :req)))
      (ok (typep response 'bb:promise))
      (ok (null (car log)))
      (funcall resolve :value)
      (ok (equal '(:resolved :value) (multiple-value-list (settle response))))
      (ok (equal '((:req :value 8)) (car log))))))

(deftest timing-does-not-report-errors-and-passes-them-on
  (let* ((log (list '()))
         (condition (make-condition 'test-error))
         (handler (make-handler '(timing-handler function-handler)
                                :function (lambda (request)
                                            (declare (ignore request))
                                            (error condition))
                                :timing-report (%reporter log)
                                :timing-clock (%clock 0 1))))
    (ok (eq condition (handler-case (let ((*trace* nil)) (handle handler :req))
                        (test-error (c) c))))
    (ok (null (car log)))))

(deftest timing-outside-error-handler-times-mapped-errors
  (let* ((log (list '()))
         (handler (make-handler '(timing-handler error-handler function-handler)
                                :function (lambda (request)
                                            (declare (ignore request))
                                            (error 'test-error))
                                :error-function (lambda (request condition)
                                                  (declare (ignore request condition))
                                                  :mapped)
                                :timing-report (%reporter log)
                                :timing-clock (%clock 0 2))))
    (ok (eq :mapped (let ((*trace* nil)) (handle handler :req))))
    (ok (equal '((:req :mapped 2)) (car log)))))

(deftest default-clock-measures-real-time
  (let* ((log (list '()))
         (handler (make-handler '(timing-handler function-handler)
                                :function (lambda (request) (sleep 0.05) request)
                                :timing-report (lambda (request response seconds)
                                                 (push (list request response seconds) (car log))))))
    (ok (functionp (timing-handler-clock handler)))
    (ok (realp (funcall (timing-handler-clock handler))))
    (handle handler :req)
    (let ((seconds (third (first (car log)))))
      (ok (realp seconds))
      (ok (<= 0.04 seconds 5)))))
